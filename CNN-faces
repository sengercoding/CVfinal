        "# Visualize original, grayscale, and colorized images\n",
        "def visualize_colorization(model, l_test, ab_test, num_images=5):\n",
        "    \"\"\"\n",
        "    Visualize original, grayscale, and colorized images\n",
        "    \"\"\"\n",
        "    # Predict colors\n",
        "    ab_pred = model.predict(l_test[:num_images])\n",
        "\n",
        "    plt.figure(figsize=(20, 12))\n",
        "\n",
        "    for i in range(num_images):\n",
        "        # Original grayscale (L channel)\n",
        "        plt.subplot(3, num_images, i + 1)\n",
        "        plt.imshow(l_test[i].squeeze(), cmap='gray')\n",
        "        plt.title('Grayscale')\n",
        "        plt.axis('off')\n",
        "\n",
        "        # Predicted color image\n",
        "        plt.subplot(3, num_images, i + num_images + 1)\n",
        "\n",
        "        # Combine L and predicted AB channels and convert back to RGB\n",
        "        lab_pred = np.zeros((l_test[i].shape[0], l_test[i].shape[1], 3))\n",
        "        lab_pred[:,:,0] = l_test[i].squeeze() * 100\n",
        "        lab_pred[:,:,1:] = ab_pred[i] * 128\n",
        "\n",
        "        # Convert LAB to RGB\n",
        "        rgb_pred = color.lab2rgb(lab_pred)\n",
        "        plt.imshow(rgb_pred)\n",
        "        plt.title('Colorized')\n",
        "        plt.axis('off')\n",
        "\n",
        "        # Original color image\n",
        "        plt.subplot(3, num_images, i + 2*num_images + 1)\n",
        "\n",
        "        # Combine L and original AB channels\n",
        "        lab_orig = np.zeros((l_test[i].shape[0], l_test[i].shape[1], 3))\n",
        "        lab_orig[:,:,0] = l_test[i].squeeze() * 100\n",
        "        lab_orig[:,:,1:] = ab_test[i] * 128\n",
        "\n",
        "        # Convert LAB to RGB\n",
        "        rgb_orig = color.lab2rgb(lab_orig)\n",
        "        plt.imshow(rgb_orig)\n",
        "        plt.title('Original Color')\n",
        "        plt.axis('off')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig('colorization_results.png')\n",
        "    plt.show()\n",
        "\n",
