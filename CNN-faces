      "source": [
        "# Function to load and preprocess images\n",
        "def load_img_lab(img_path, target_size=(256, 256)):\n",
        "    \"\"\"\n",
        "    Load an image, resize it and convert to LAB color space\n",
        "    Returns L and AB channels separately\n",
        "    \"\"\"\n",
        "    # Load and resize image\n",
        "    img = load_img(img_path, target_size=target_size)\n",
        "    img = img_to_array(img) / 255.0  # Normalize to [0, 1]\n",
        "\n",
        "    # Convert to LAB\n",
        "    lab = color.rgb2lab(img)\n",
        "\n",
        "    # Split into L and AB channels\n",
        "    l_channel = lab[:,:,0] / 100.0  # Normalize L to [0, 1]\n",
        "    ab_channels = lab[:,:,1:] / 128.0  # Normalize AB to [-1, 1]\n",
        "\n",
        "    return l_channel, ab_channels\n",
        "\n",
        "# Function to find all image files in the dataset\n",
        "def get_image_files(dataset_path):\n",
        "    \"\"\"\n",
        "    Get all image files from the dataset directory\n",
        "    \"\"\"\n",
        "    image_extensions = ['*.jpg', '*.jpeg', '*.png']\n",
        "    image_files = []\n",
        "    for ext in image_extensions:\n",
        "        image_files.extend(glob(os.path.join(dataset_path, '**', ext), recursive=True))\n",
        "\n",
        "    print(f\"Found {len(image_files)} images\")\n",
        "    return image_files"
      ],
      "metadata": {
        "id": "m6ui6lw3Z3Fj"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Prepare dataset\n",
        "def prepare_dataset(image_files, target_size=(256, 256), max_samples=None, test_size=0.2):\n",
        "    \"\"\"\n",
        "    Prepare train and test datasets with L and AB channels\n",
        "    \"\"\"\n",
        "    if max_samples and max_samples < len(image_files):\n",
        "        image_files = image_files[:max_samples]\n",
        "\n",
        "    # Initialize empty arrays\n",
        "    l_channels = []\n",
        "    ab_channels = []\n",
        "\n",
        "    print(\"Processing images...\")\n",
        "    for i, img_path in enumerate(image_files):\n",
        "        try:\n",
        "            l, ab = load_img_lab(img_path, target_size=target_size)\n",
        "            l_channels.append(l)\n",
        "            ab_channels.append(ab)\n",
        "\n",
        "            if i % 100 == 0 or i == len(image_files) - 1:\n",
        "                print(f\"Processed {i+1}/{len(image_files)} images\")\n",
        "        except Exception as e:\n",
        "            print(f\"Error processing {img_path}: {e}\")\n",
        "\n",
        "    # Convert to numpy arrays\n",
        "    l_channels = np.array(l_channels)\n",
        "    ab_channels = np.array(ab_channels)\n",
        "\n",
        "    # Reshape L for model input (add channel dimension)\n",
        "    l_channels = l_channels.reshape(l_channels.shape + (1,))\n",
        "\n",
        "    # Split into train and test sets\n",
        "    l_train, l_test, ab_train, ab_test = train_test_split(\n",
        "        l_channels, ab_channels, test_size=test_size, random_state=42\n",
        "    )\n",
        "\n",
        "    print(f\"Training set: {l_train.shape[0]} images\")\n",
        "    print(f\"Testing set: {l_test.shape[0]} images\")\n",
        "\n",
        "    return l_train, l_test, ab_train, ab_test"
      ],
