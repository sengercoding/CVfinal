        "        plt.title('Grayscale')\n",
        "        plt.axis('off')\n",
        "\n",
        "        # Reconstructed color image\n",
        "        plt.subplot(2, num_images, i + num_images + 1)\n",
        "\n",
        "        # Combine L and AB channels and convert back to RGB\n",
